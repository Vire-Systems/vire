# This is more of a config .env than a secrets .env
# So i'm putting this out here for anyone who is working with vire.

#Delimit both with commas (',')
AVAILABLE_FRAMEWORKS=vite,...
CANCELLABLE=queued,running
CORE_ID="core-1"

CONTAINER_RUNTIME=docker

REDIS_URL=redis://127.0.0.1:6379

DB_PATH=/home/vire/Vire-DB/vire_state.db
DB_URL=sqlite+aiosqlite:////home/vire/Vire-DB/vire_state.db

CORE_LOGDIR=/home/vire/vire_logs/core
WORKER_LOGDIR=/home/vire/vire_logs/workers
GC_LOGDIR=/home/vire/vire_logs/gc

PYTHON_BIN_PATH=/home/vire/vire/venv/bin/python
WORKER_PATH=/home/vire/vire/BuildScheduler/worker/worker.py
WORKER_OUTPUT_DIR="/home/vire/vire/test"

LOG_LEVEL=info
